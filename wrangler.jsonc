{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codebuddy-token-dashboard",
  "compatibility_date": "2026-10-01",
  // 纯静态：vite-plugin-singlefile 只产出 dist/index.html，全部逻辑在浏览器里跑。
  // 用 Workers 静态资源（而非 Pages）托管，后续要加边缘函数可直接扩。
  "assets": {
    "directory": "./dist",
    // 单页应用：任何未命中的路径都回落到 index.html
    // 回落只在这里定义；切勿在 public/ 加 _redirects，上传版本时会被判定为无限循环（code 100324）
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
