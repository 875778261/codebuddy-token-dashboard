{
  "name": "codebuddy-token-dashboard",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run lint:copy",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint:copy": "tsx scripts/lint-copy.ts",
    "verify": "python scripts/ground-truth.py && tsx scripts/verify-pipeline.ts",
    "verify:ts": "tsx scripts/verify-pipeline.ts",
    "bridge": "node scripts/bridge.mjs",
    "collect": "tsx scripts/collect.ts",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "deploy:manual": "npm run build && wrangler deploy",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name codebuddy-token-dashboard --branch main"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@types/node": "^22.20.5",
    "echarts": "^5.5.1",
    "gsap": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.2",
    "vitest": "^2.1.4",
    "wrangler": "^4.156.0"
  }
}
